#!/usr/bin/env bash

# Resolve symlinks to find real source directory of this script
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# Preserve the real original user HOME directory before any CLI profile redirection
export AI_ORIGINAL_HOME="${AI_ORIGINAL_HOME:-$HOME}"

# Determine config directory reliably regardless of whether HOME is redirected
if [ -z "$AI_CONFIG_DIR" ]; then
    if [ -n "$AI_ORIGINAL_HOME" ] && [ -d "$AI_ORIGINAL_HOME/.config/ai" ]; then
        AI_CONFIG_DIR="$AI_ORIGINAL_HOME/.config/ai"
    elif [ -d "$HOME/.config/ai" ]; then
        AI_CONFIG_DIR="$HOME/.config/ai"
    elif [ -d "$SCRIPT_DIR/../lib" ] && [ -d "$SCRIPT_DIR/../cli" ]; then
        AI_CONFIG_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
    elif [ -d "$SCRIPT_DIR/lib" ] && [ -d "$SCRIPT_DIR/cli" ]; then
        AI_CONFIG_DIR="$SCRIPT_DIR"
    else
        AI_CONFIG_DIR="$HOME/.config/ai"
    fi
fi
export AI_CONFIG_DIR

# Determine root library location
if [ -d "$SCRIPT_DIR/lib" ]; then
    LIB_DIR="$SCRIPT_DIR/lib"
elif [ -d "$SCRIPT_DIR/../lib" ]; then
    # Installed layout: bin/ai with lib/ alongside bin/.
    LIB_DIR="$(cd "$SCRIPT_DIR/../lib" >/dev/null 2>&1 && pwd)"
elif [ -d "$AI_CONFIG_DIR/lib" ]; then
    LIB_DIR="$AI_CONFIG_DIR/lib"
else
    echo "[ERROR] Cannot locate lib/ directory for AI CLI Helper."
    exit 1
fi

# Load libraries
source "$LIB_DIR/utils.sh"
source "$LIB_DIR/provider.sh"
source "$LIB_DIR/env.sh"
source "$LIB_DIR/cli.sh"
source "$LIB_DIR/doctor.sh"

show_help() {
    cat << EOF
${BOLD}AI CLI Helper${NC} - One Command. Every AI CLI.

${BOLD}USAGE:${NC}
  ai <command> [args]
  ai <cli_name_or_alias> [args]  (e.g., ai codex, ai codexa, ai agy, ai agya, ai agyb)

${BOLD}PROVIDER COMMANDS:${NC}
  ai provider use <name>     Switch default active provider
  ai provider current        Show default active provider
  ai provider list           List available providers
  ai provider add [name]     Add a new provider configuration
  ai provider remove <name>  Remove a provider configuration

${BOLD}ENVIRONMENT COMMANDS:${NC}
  ai env [alias]             Display environment variables for provider/alias
  ai env export [alias]      Export environment variables for provider/alias
  ai env reset               Reset default active provider to 'openai'

${BOLD}ALIAS ENGINE:${NC}
  支持直接绑定专属 API/URL 或多账号配置！
  在 ~/.config/ai/providers/ 中建立对应的文件，例如 codexa.sh, agya.sh, agyb.sh。
  当执行 'ai <alias>' 时，系统会自动：
  1. 匹配底层真实的 CLI（codex, claude, agy, gemini 等）
  2. 优先装载 providers/<alias>.sh 与 secrets/<alias>.sh
  3. 创建独立隔离的 HOME 目录 (~/.local/share/ai/<cli>/<profile>/)

${BOLD}GOOGLE ANTIGRAVITY (AGY) OAUTH:${NC}
  agy 使用 Google OAuth 授权，支持多账号独立登录与完全隔离：
  1. 运行 'ai agya' -> 首次提示 Google 授权链接，在浏览器登录账号 A
  2. 运行 'ai agyb' -> 首次提示 Google 授权链接，在浏览器登录账号 B
  3. 各账号 OAuth 凭据完全独立隔离，同时全局共享对话记录、工作空间、历史会话、MCP 与 Skills 配置
     多终端并发运行不同账号互不干扰、永不串号！任意账号均可无缝继续已有工作空间与会话！
  4. 辅助指令：
     ai agya whoami          # 查看当前绑定的 Google 账号
     ai agya login           # 重新发起登录
     ai agya logout          # 退出当前账号并清除凭据
     ai reset agya           # 重置该别名的 HOME 与 Auth 状态

${BOLD}CHATGPT OAUTH EXAMPLE:${NC}
  codexh 使用独立 profile 保存 ChatGPT OAuth 登录状态：
  1. ai codexh login
  2. 在浏览器完成 ChatGPT 登录
  3. ai codexh

${BOLD}SYSTEM COMMANDS:${NC}
  ai doctor                  Run diagnostic check
  ai update                  Pull latest git updates
  ai reset [alias] [profile] Reset HOME profile environment (e.g. ai reset agya, ai reset claude)
  ai init                    Initialize configuration directory structure
  ai help                    Show this help message

EOF
}

init_config_dir() {
    info "Initializing configuration at $AI_CONFIG_DIR ..."
    mkdir -p "$AI_CONFIG_DIR"/{providers,secrets,cli,lib,templates,bin}

    # Copy files from repository if running from source repo
    if [ "$SCRIPT_DIR" != "$AI_CONFIG_DIR" ]; then
        cp -r "$SCRIPT_DIR/providers/"* "$AI_CONFIG_DIR/providers/" 2>/dev/null || true
        cp -r "$SCRIPT_DIR/cli/"* "$AI_CONFIG_DIR/cli/" 2>/dev/null || true
        cp -r "$SCRIPT_DIR/lib/"* "$AI_CONFIG_DIR/lib/" 2>/dev/null || true
        cp -r "$SCRIPT_DIR/templates/"* "$AI_CONFIG_DIR/templates/" 2>/dev/null || true
        if [ -f "$SCRIPT_DIR/ai-init.sh" ]; then
            cp "$SCRIPT_DIR/ai-init.sh" "$AI_CONFIG_DIR/ai-init.sh" 2>/dev/null || true
        fi
        chmod +x "$AI_CONFIG_DIR/ai-init.sh" 2>/dev/null || true
        if [ -f "$SCRIPT_DIR/init-ai.sh" ]; then
            cp "$SCRIPT_DIR/init-ai.sh" "$AI_CONFIG_DIR/init-ai.sh" 2>/dev/null || true
            chmod +x "$AI_CONFIG_DIR/init-ai.sh" 2>/dev/null || true
        fi
        cp "$SCRIPT_DIR/ai" "$AI_CONFIG_DIR/bin/ai" 2>/dev/null || true
        chmod +x "$AI_CONFIG_DIR/bin/ai"
        chmod +x "$AI_CONFIG_DIR/cli/"*.sh 2>/dev/null || true
        chmod +x "$AI_CONFIG_DIR/lib/"*.sh 2>/dev/null || true
    fi

    # Create secrets if missing
    for p_file in "$AI_CONFIG_DIR/providers/"*.sh; do
        [ -e "$p_file" ] || continue
        local p_name
        p_name=$(basename "$p_file" .sh)
        local s_file="$AI_CONFIG_DIR/secrets/${p_name}.sh"
        if [ ! -f "$s_file" ]; then
            cp "$AI_CONFIG_DIR/templates/secret.sh.template" "$s_file"
            chmod 600 "$s_file"
        fi
    done

    # Default provider
    if [ ! -f "$AI_CONFIG_DIR/current_provider" ]; then
        echo "openai" > "$AI_CONFIG_DIR/current_provider"
    fi

    # Add to ~/.zshrc or ~/.bashrc if needed (macOS defaults to zsh)
    local SHELL_RC=""
    local user_home="${AI_ORIGINAL_HOME:-$HOME}"
    if [[ "$SHELL" == *"zsh"* ]] || [ -n "$ZSH_VERSION" ]; then
        SHELL_RC="$user_home/.zshrc"
    elif [[ "$SHELL" == *"bash"* ]] || [ -n "$BASH_VERSION" ]; then
        SHELL_RC="$user_home/.bashrc"
    elif [ -f "$user_home/.zshrc" ]; then
        SHELL_RC="$user_home/.zshrc"
    elif [ -f "$user_home/.bashrc" ]; then
        SHELL_RC="$user_home/.bashrc"
    fi

    if [ -n "$SHELL_RC" ]; then
        # Clean up old init-ai.sh reference if exists (portable sed)
        if grep -q "init-ai.sh" "$SHELL_RC" 2>/dev/null; then
            sed -i.bak '/init-ai\.sh/d' "$SHELL_RC" && rm -f "${SHELL_RC}.bak"
        fi
        if ! grep -q "ai-init.sh" "$SHELL_RC" 2>/dev/null; then
            echo "" >> "$SHELL_RC"
            echo "# AI CLI Helper Initialization" >> "$SHELL_RC"
            echo "[ -f \"$AI_CONFIG_DIR/ai-init.sh\" ] && source \"$AI_CONFIG_DIR/ai-init.sh\"" >> "$SHELL_RC"
            success "Added init script entry to $SHELL_RC"
        else
            info "Init script already sourced in $SHELL_RC"
        fi
    fi

    success "Initialization complete! Run 'source $SHELL_RC' or restart your terminal."
    info "ChatGPT OAuth example: ai codexh login && ai codexh"
    info "Google Antigravity OAuth example: ai agya && ai agyb"
}

update_repo() {
    info "Updating AI CLI Helper..."
    if [ -d "$SCRIPT_DIR/.git" ]; then
        (cd "$SCRIPT_DIR" && git pull)
        init_config_dir
        success "Update completed successfully."
    else
        warn "Script directory is not a git repository. Cannot run git pull."
    fi
}

main() {
    local cmd="$1"
    shift || true

    case "$cmd" in
        provider)
            local subcmd="$1"
            shift || true
            case "$subcmd" in
                use) set_current_provider "$1" ;;
                current) get_current_provider ;;
                list) list_providers ;;
                add) add_provider "$1" ;;
                remove|rm) remove_provider "$1" ;;
                *) error "Unknown provider command: $subcmd"; show_help ;;
            esac
            ;;
        env)
            local subcmd="$1"
            shift || true
            case "$subcmd" in
                ""|show) show_env "$1" ;;
                export) export_env "$1" ;;
                reset) set_current_provider "openai" ;;
                *) show_env "$subcmd" ;;
            esac
            ;;
        doctor)
            run_doctor
            ;;
        update)
            update_repo
            ;;
        reset)
            reset_cli_home "$@"
            ;;
        init)
            init_config_dir
            ;;
        help|--help|-h|"")
            show_help
            ;;
        *)
            run_cli "$cmd" "$@"
            ;;
    esac
}

main "$@"
